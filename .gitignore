# Build output
/bin/
/dist/
*.exe
*.exe~

# Generated by odm-setup: unique to each install, and the manifest key is
# derived from a private key that must not be shared.
/extension/key.pem
*.pem

# Staged by build.ps1 into the setup program; rebuilt every time.
/cmd/odm-installer/payload/*
!/cmd/odm-installer/payload/.gitkeep

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini

# Agent and skill caches
/.agents/
/.claude/skills/
/skills-lock.json
