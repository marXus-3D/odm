{
  "manifest_version": 3,
  "name": "DM Integration",
  "version": "0.1.0",
  "description": "Hand browser downloads to the DM download manager for parallel, resumable transfers.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "nativeMessaging",
    "notifications",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "DM"
  },
  "options_page": "options.html",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  }
}
